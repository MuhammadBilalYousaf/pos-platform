NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MySQL — Flutter never uses these values
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pos_platform

# Firebase Admin (JSON string OR file path). Never ship this to Flutter.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: bind seed users to real Firebase UIDs
SEED_ADMIN_FIREBASE_UID=
SEED_CASHIER_FIREBASE_UID=

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080
