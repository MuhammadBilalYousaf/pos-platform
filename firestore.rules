rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----- Signed-in allow (needed so Super Admin signup can write) -----
    // If any matching rule allows access, Firestore grants it.
    // Keep this while bootstrapping; remove later for stricter production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Users collection (also covered by catch-all above)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Top-level catalog/orders (legacy paths; live POS data is under businesses/{id}/...)
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ----- Role helpers (used when catch-all is removed) -----
    function signedIn() {
      return request.auth != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(userPath());
    }
    function profile() {
      return get(userPath()).data;
    }
    function isActiveUser() {
      return hasProfile() && (!('active' in profile()) || profile().active != false);
    }
    function isPlatformAdmin() {
      return isActiveUser() && profile().role == 'platform_super_admin';
    }
    function isBizAdmin() {
      return isActiveUser() && profile().role == 'business_admin';
    }
    function isManager() {
      return isActiveUser() && profile().role == 'branch_manager';
    }
    function isCashier() {
      return isActiveUser() && profile().role == 'cashier';
    }
    function myBiz() {
      return profile().businessId;
    }
    function assignedBranches() {
      return ('branchIds' in profile() && profile().branchIds.size() > 0)
        ? profile().branchIds
        : (('branchId' in profile()) ? [profile().branchId] : []);
    }
    function inAssignedBranch(branchId) {
      return isBizAdmin() || isPlatformAdmin() || branchId in assignedBranches();
    }
    function canAccess(bizId) {
      return isPlatformAdmin() || (isActiveUser() && myBiz() == bizId);
    }
    function canWriteCatalog(bizId) {
      return isPlatformAdmin() || (canAccess(bizId) && isBizAdmin());
    }
    function canManageOrg(bizId) {
      return isPlatformAdmin() || (canAccess(bizId) && isBizAdmin());
    }
    function canManageOps(bizId) {
      return isPlatformAdmin() || (canAccess(bizId) && (isBizAdmin() || isManager()));
    }
    function canSell(bizId) {
      return canAccess(bizId) && (isBizAdmin() || isManager() || isCashier());
    }
    function unlockedOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owner_unlocks/$(request.auth.uid));
    }
    function staffRoleOk(role) {
      return role in ['business_admin', 'branch_manager', 'cashier'];
    }
    function bizStatusOk(bizId) {
      return !('status' in get(/databases/$(database)/documents/businesses/$(bizId)).data)
        || get(/databases/$(database)/documents/businesses/$(bizId)).data.status == 'active';
    }

    // ----- Super Admin unlock (secret code in platform/owner_gate) -----
    match /owner_unlocks/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/platform/owner_gate)
        && request.resource.data.code == get(/databases/$(database)/documents/platform/owner_gate).data.code;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow read, update: if false;
    }

    match /platform/{docId} {
      allow read: if docId == 'state';
      allow create: if signedIn()
        && docId == 'state'
        && unlockedOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/platform/state);
      allow update: if docId == 'state' && (isPlatformAdmin() || unlockedOwner());
      allow delete: if isPlatformAdmin() && docId == 'state';
    }

    match /platform_audit/{id} {
      allow read, create: if isPlatformAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isPlatformAdmin()
        || (isBizAdmin() && resource.data.businessId == myBiz())
        || (isManager() && resource.data.businessId == myBiz() && resource.data.branchId in assignedBranches())
      );
      allow create: if signedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.role == 'platform_super_admin'
          && unlockedOwner()
        )
        || isPlatformAdmin()
        || (
          isBizAdmin()
          && request.resource.data.businessId == myBiz()
          && staffRoleOk(request.resource.data.role)
        )
        || (
          isManager()
          && request.resource.data.businessId == myBiz()
          && request.resource.data.role == 'cashier'
          && request.resource.data.branchId in assignedBranches()
        )
      );
      allow update: if isPlatformAdmin()
        || (
          isBizAdmin()
          && resource.data.businessId == myBiz()
          && request.resource.data.businessId == myBiz()
          && request.resource.data.role != 'platform_super_admin'
        )
        || (
          isManager()
          && resource.data.businessId == myBiz()
          && request.resource.data.businessId == myBiz()
          && resource.data.role == 'cashier'
          && request.resource.data.role == 'cashier'
          && request.resource.data.branchId in assignedBranches()
        )
        || (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.businessId == resource.data.businessId
        );
      allow delete: if isPlatformAdmin();
    }

    match /businesses/{bizId} {
      allow read: if canAccess(bizId);
      allow create: if isPlatformAdmin();
      // Cashiers/managers must bump orderSeq when completing a sale.
      allow update: if isPlatformAdmin()
        || (canAccess(bizId) && isBizAdmin())
        || (
          canSell(bizId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderSeq'])
        );
      allow delete: if isPlatformAdmin();

      match /branches/{id} {
        allow read: if canAccess(bizId) && (isBizAdmin() || isPlatformAdmin() || inAssignedBranch(id));
        allow create, update: if canManageOrg(bizId);
        allow delete: if isPlatformAdmin();
      }
      match /categories/{id} {
        allow read: if canAccess(bizId);
        allow write: if canWriteCatalog(bizId);
      }
      match /products/{id} {
        allow read: if canAccess(bizId);
        allow write: if canWriteCatalog(bizId);
      }
      match /ingredients/{id} {
        allow read: if canAccess(bizId);
        allow write: if canWriteCatalog(bizId) || canManageOps(bizId);
      }
      match /units/{id} {
        allow read: if canAccess(bizId);
        allow write: if canWriteCatalog(bizId);
      }
      match /recipes/{id} {
        allow read: if canAccess(bizId);
        allow write: if canManageOps(bizId);
      }
      match /discounts/{id} {
        allow read: if canAccess(bizId);
        allow write: if canManageOrg(bizId);
      }
      match /suppliers/{id} {
        allow read: if canAccess(bizId) && canManageOps(bizId);
        allow write: if canManageOps(bizId);
      }
      match /purchases/{id} {
        allow read: if canAccess(bizId) && canManageOps(bizId) && (isBizAdmin() || isPlatformAdmin() || inAssignedBranch(resource.data.branch_id));
        allow create: if canManageOps(bizId) && inAssignedBranch(request.resource.data.branch_id);
        allow update: if canManageOrg(bizId);
      }
      match /stock_transfers/{id} {
        allow read: if canAccess(bizId) && canManageOps(bizId);
        allow create: if canAccess(bizId) && isBizAdmin();
      }
      match /waste/{id} {
        allow read: if canAccess(bizId) && canManageOps(bizId) && (isBizAdmin() || inAssignedBranch(resource.data.branch_id));
        allow create: if canManageOps(bizId) && inAssignedBranch(request.resource.data.branch_id);
      }
      match /inventory/{id} {
        allow read: if canAccess(bizId) && (isBizAdmin() || isPlatformAdmin() || inAssignedBranch(resource.data.branch_id));
        allow create: if canManageOps(bizId) && inAssignedBranch(request.resource.data.branch_id);
        allow update: if canAccess(bizId)
          && (isBizAdmin() || isPlatformAdmin() || inAssignedBranch(resource.data.branch_id))
          && (canManageOps(bizId) || canSell(bizId));
      }
      match /inventory_transactions/{id} {
        allow read: if canAccess(bizId) && canManageOps(bizId);
        allow create: if canManageOps(bizId) || canSell(bizId);
      }
      match /orders/{id} {
        allow read: if canAccess(bizId) && (isBizAdmin() || isPlatformAdmin() || inAssignedBranch(resource.data.branch_id));
        allow create: if canSell(bizId)
          && bizStatusOk(bizId)
          && inAssignedBranch(request.resource.data.branch_id);
        allow update: if canManageOps(bizId) && (isBizAdmin() || inAssignedBranch(resource.data.branch_id));
      }
      match /customers/{id} {
        allow read: if canAccess(bizId) && canSell(bizId);
        allow write: if canSell(bizId);
      }
      match /audit_logs/{id} {
        allow read: if canAccess(bizId) && (isBizAdmin() || isPlatformAdmin() || isManager());
        allow create: if canAccess(bizId);
      }
    }
  }
}
